<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>FoodBuffOverlay</AssemblyName>
    <AssemblyTitle>Food Buff Overlay for ACT</AssemblyTitle>
    <RootNamespace>FoodBuffOverlay</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.2.0</Version>
    <Authors>Roxyz0501</Authors>
    <Company>Roxyz0501</Company>
    <Product>Food Buff Overlay for ACT</Product>
    <Description>FFXIV food buff warning overlay for Advanced Combat Tracker.</Description>
    <Copyright>Copyright © Roxyz0501</Copyright>
    <ActPath Condition="'$(ActPath)' == ''">C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
